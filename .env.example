# Copy this file to .env.local and fill in both keys. Never commit .env.local.
# Ollama Cloud writes the guide:  https://ollama.com/settings/keys
# Tavily does the web search:     https://tavily.com  (free plan, no card)

OLLAMA_API_KEY=
TAVILY_API_KEY=

# Optional: Ollama cloud model name (see https://ollama.com/api/tags). Leave empty for the default.
OLLAMA_MODEL=

# Optional (leave unset to use the defaults):
# GUIDE_STORE_DIR=
# GENERATE_LIMIT_PER_HOUR=
